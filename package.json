{
  "name": "@hezarfen/claude-oauth-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OAuth-only local model router for Claude Code",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "claude-oauth": "dist/src/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs && npm run typecheck",
    "test": "npm run build && node --test dist/test/*.test.js",
    "coverage": "npm run build && node --test --experimental-test-coverage dist/test/*.test.js",
    "secret-scan": "node scripts/secret-scan.mjs",
    "check": "npm run lint && npm run test && npm run secret-scan",
    "start": "node dist/src/cli.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@bman654/clodex": "2.11.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
