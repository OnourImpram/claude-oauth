{
  "name": "@onour-impram/claude-oauth",
  "version": "0.1.0",
  "description": "Run other models inside Claude Code over their own OAuth sessions, without replacing the native Claude path",
  "keywords": [
    "claude-code",
    "router",
    "oauth",
    "model-router",
    "agent-harness",
    "antigravity",
    "grok",
    "codex",
    "mcp"
  ],
  "homepage": "https://onourimpram.github.io/claude-oauth/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnourImpram/claude-oauth.git"
  },
  "bugs": {
    "url": "https://github.com/OnourImpram/claude-oauth/issues"
  },
  "license": "Apache-2.0",
  "author": "Onour Impram",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist/src",
    "config",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "claude-oauth": "dist/src/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs && npm run typecheck",
    "test": "npm run build && node --test dist/test/*.test.js",
    "coverage": "npm run build && node --test --experimental-test-coverage dist/test/*.test.js",
    "secret-scan": "node scripts/secret-scan.mjs",
    "check": "npm run lint && npm run test && npm run secret-scan",
    "self-check": "node scripts/lint.mjs --ozdenetim && node scripts/secret-scan.mjs --ozdenetim && node scripts/release-id.mjs --ozdenetim",
    "start": "node dist/src/cli.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@bman654/clodex": "2.11.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
